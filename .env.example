# Kopieren nach .env und anpassen. .env wird nicht eingecheckt.

# Port auf dem Host (nur ohne Caddy relevant)
HTTP_PORT=8080

# Mit HTTPS über Caddy (docker compose --profile https up -d):
# DOMAIN=darts.example.de
# TRUST_PROXY=true

# Sitzungsdauer in Tagen (gleitend verlängert, solange die App benutzt wird)
SESSION_DAYS=90

# Secure-Cookie: auto (= nur bei HTTPS) | true | false
COOKIE_SECURE=auto

# Max. Anfragen pro Minute und IP auf die Anmelde-Endpunkte
AUTH_RATE_PER_MIN=30

# scrypt-Kosten (log2 N). 15 ≈ 32 MB RAM pro Hash. Höher = sicherer, aber langsamer.
SCRYPT_LOG_N=15

# Max. Größe einer Anfrage in MB (Sync großer Spielhistorien)
MAX_BODY_MB=20
